{
  "config": {
    "step": {
      "user": {
        "description": "Connect to the Wattpilot on your local network. The password is the one used in the Wattpilot.Solar app.",
        "data": {"host": "Host", "password": "Password"}
      },
      "reauth_confirm": {
        "description": "The charger rejected the stored password. Enter the current one.",
        "data": {"password": "Password"}
      },
      "reconfigure": {
        "description": "Update the charger's network address.",
        "data": {"host": "Host", "password": "Password"}
      }
    },
    "error": {
      "cannot_connect": "Cannot connect to the charger",
      "invalid_auth": "Invalid password",
      "wrong_device": "The charger at this address has a different serial number"
    },
    "abort": {
      "already_configured": "This charger is already configured",
      "reauth_successful": "Password updated",
      "reconfigure_successful": "Configuration updated"
    }
  },
  "options": {
    "step": {
      "init": {
        "data": {
          "update_interval": "Update interval (seconds)"
        },
        "data_description": {
          "update_interval": "Coalesce charger updates: at most one update per entity per interval. 0 forwards every change immediately."
        }
      }
    }
  },
  "exceptions": {
    "cloud_not_supported": {
      "message": "Cloud connections are not supported yet. Reconfigure the entry with the charger's local address."
    },
    "duplicate_device": {
      "message": "Charger {serial} is already configured by another entry."
    },
    "invalid_device": {
      "message": "Device {device_id} is not a loaded Wattpilot charger."
    },
    "wrong_charger": {
      "message": "This entry belongs to charger {expected}, but the charger at this address reports serial {found}. If you replaced the charger, delete this entry and add the new one."
    }
  },
  "issues": {
    "migration_collision": {
      "title": "Some entities could not be migrated",
      "description": "These entities from a previously installed Wattpilot integration keep their old identifier, because an entity with the new one already exists: {entities}.\n\nNothing was deleted. Each of them still holds its history, entity ID and customisations, but no longer belongs to a loaded integration, so it shows as unavailable. The entity that is loaded is the one that was already there.\n\nDecide per entity which one to keep: delete the unavailable one if its history does not matter to you, or delete the loaded one and restart Home Assistant, so the old one is adopted in its place."
    }
  },
