  "exceptions": {
    "cloud_not_supported": {
      "message": "Cloud-Verbindungen werden noch nicht unterstützt. Den Eintrag mit der lokalen Adresse des Ladegeräts neu konfigurieren."
    },
    "duplicate_device": {
      "message": "Ladegerät {serial} ist bereits durch einen anderen Eintrag konfiguriert."
    },
    "invalid_device": {
      "message": "Gerät {device_id} ist kein aktives Wattpilot-Ladegerät."
    },
    "wrong_charger": {
      "message": "Dieser Eintrag gehört zu Ladegerät {expected}, das Gerät unter dieser Adresse meldet aber die Seriennummer {found}. Wurde das Ladegerät ersetzt, diesen Eintrag löschen und das neue hinzufügen."
    }
  },
  "issues": {
    "migration_collision": {
      "title": "Einige Entitäten konnten nicht migriert werden",
      "description": "Diese Entitäten einer früher installierten Wattpilot-Integration behalten ihre alte Kennung, weil bereits eine Entität mit der neuen existiert: {entities}.\n\nEs wurde nichts gelöscht. Jede von ihnen trägt weiterhin ihre Historie, Entitäts-ID und Anpassungen, gehört aber zu keiner geladenen Integration mehr und erscheint deshalb als nicht verfügbar. Geladen ist jeweils die Entität, die bereits vorhanden war.\n\nEntscheide je Entität, welche bleiben soll: die nicht verfügbare löschen, wenn dir ihre Historie egal ist — oder die geladene löschen und Home Assistant neu starten, damit die alte an ihre Stelle tritt."
    }
  },
